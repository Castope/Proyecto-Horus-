{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32 ::1/128}
		trusted_proxies_strict
		client_ip_headers X-Real-IP X-Forwarded-For
	}
}

:{$PORT:8080} {
	encode gzip

	handle /healthz {
		respond "ok" 200
	}

	# Conserva /api en la ruta que recibe NestJS.
	@api path /api /api/*
	handle @api {
		reverse_proxy {$BACKEND_UPSTREAM:backend.railway.internal:3000} {
			header_up X-Forwarded-For {client_ip}
			header_up -X-Real-IP
		}
	}

	# Permite recargar las rutas de React Router.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
